# Get a key at https://indus.sarvam.ai/key-management — never commit the real .env
SARVAM_API_KEY=
# Optional overrides
DRISHTI_PORT=8787
MOCK_PORT=5174
DRISHTI_SPEAKER=kavya
# Extra sites the agent may open, comma-separated (the default list is in packages/core/src/agent/policy.ts)
DRISHTI_ALLOW=
# Optional profile for filling forms "for me". Leave empty and Drishti asks instead.
PROFILE_NAME=
PROFILE_AGE=
PROFILE_GENDER=
PROFILE_MOBILE=
