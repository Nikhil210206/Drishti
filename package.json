{
  "name": "drishti",
  "version": "0.1.0",
  "description": "Voice-first web agent for blind users in 11 Indian languages",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,panel \"npm run server -w @drishti/dev-harness\" \"npm run dev -w @drishti/ui\"",
    "start": "npm run build && npm run start -w @drishti/dev-harness",
    "build": "npm run build -w @drishti/ui && npm run build -w @drishti/extension",
    "check": "npm run check -w @drishti/dev-harness --",
    "snapshot": "npm run snapshot -w @drishti/dev-harness --",
    "eval": "tsx eval/run.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tsconfig.json",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ci": "npm run lint && npm run format:check && npm run typecheck && npm test",
    "eval:extension": "tsx eval/run.ts --driver=extension"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nikhil210206/Drishti.git"
  },
  "bugs": {
    "url": "https://github.com/Nikhil210206/Drishti/issues"
  },
  "homepage": "https://github.com/Nikhil210206/Drishti#readme",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "concurrently": "^10.0.5",
    "oxlint": "^1.86.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2",
    "yaml": "^2.9.1"
  }
}
